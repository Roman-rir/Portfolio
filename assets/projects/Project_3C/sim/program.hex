17100005    // PC=0  : RF1 = 5
17200005    // PC=1  : RF2 = 5
40012000    // PC=2  : Branch if Zero
            //        5-5=0, condition TRUE
            //        offset=0

1710000F    // PC=3  : RF1 = 15
17200007    // PC=4  : RF2 = 7
40012100    // PC=5  : Branch if Positive
            //        15-7=8, condition TRUE
            //        offset=0

17100007    // PC=6  : RF1 = 7
1720000F    // PC=7  : RF2 = 15
40012200    // PC=8  : Branch if Negative
            //        7-15=-8, condition TRUE
            //        offset=0

17100001    // PC=9  : RF1 = 1
17200009    // PC=10 : RF2 = 9
400123F5    // PC=11 : Branch Always
            //        F5 = -11
            //        PC = 11 + (-11) = 0

00000000    // PC=12
00000000    // PC=13
00000000    // PC=14
00000000    // PC=15
