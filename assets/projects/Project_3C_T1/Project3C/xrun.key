database -open waves -into waves.shm -default
probe -create -shm RISC_V3_tb.DUV.SYS_CLOCK RISC_V3_tb.DUV.RST RISC_V3_tb.DUV.PC RISC_V3_tb.DUV.IR RISC_V3_tb.DUV.DM_ADDR RISC_V3_tb.BRANCH_DIR RISC_V3_tb.DUV.DM_IN RISC_V3_tb.DUV.DM_OUT RISC_V3_tb.DUV.IMM_DATA RISC_V3_tb.DUV.PM_OUT RISC_V3_tb.DUV.RF_Q1 RISC_V3_tb.DUV.RF_Q2 RISC_V3_tb.DUV.ALU_OUT RISC_V3_tb.DUV.DM_WR RISC_V3_tb.DUV.PSTATE
run
exit
